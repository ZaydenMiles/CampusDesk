# Copy to .env:   cp .env.example .env
# .env is gitignored. Your API key must never be committed.

# The part before .freshdesk.com, e.g. "uni-service-desk"
FRESHDESK_DOMAIN=your-subdomain
# Freshdesk -> profile picture (top right) -> Profile settings -> View API key
FRESHDESK_API_KEY=paste-your-api-key-here

# Any long random string. The same value goes into the Freshdesk webhook header.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me

# A mailbox you own. Gmail plus-addressing works: you+student1@gmail.com
DEMO_REQUESTER_EMAIL=you+student@gmail.com

# 1 = no Freshdesk needed: a pretend helpdesk in memory (same as `make demo`)
DEMO_MODE=0

EVENTS_DB=data/events.db
DEMO_TAG=usd-demo
LOG_LEVEL=INFO
