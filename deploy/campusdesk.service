[Unit]
Description=CampusDesk portal
After=network-online.target
Wants=network-online.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/campusdesk
ExecStart=/home/azureuser/campusdesk/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
